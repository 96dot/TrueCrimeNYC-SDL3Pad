{
  "mustExist": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "TCNYCSDL3Pad.ini",
    "licenses/SDL3-LICENSE.txt",
    "docs/HOW-IT-WAS-FIXED.md",
    "build.bat",
    "sdl3_min.h"
  ],
  "commands": [
    {
      "name": "plugin builds with no warnings",
      "run": "python tools/build_check.py",
      "slow": true,
      "timeoutMin": 5
    },
    {
      "name": "byte patterns match tcnyc.exe the way the plugin uses them",
      "run": "python tools/pattern_check.py"
    },
    {
      "name": "offline replay of the game's DirectInput calls",
      "run": "python tools/harness_check.py",
      "slow": true,
      "timeoutMin": 5
    }
  ],
  "inStep": [
    {
      "name": "version: code matches changelog",
      "a": {
        "file": "tcnyc_sdl3pad.c",
        "regex": "#define VERSION \"(\\d+\\.\\d+\\.\\d+)\""
      },
      "b": {
        "file": "CHANGELOG.md",
        "regex": "## \\[(\\d+\\.\\d+\\.\\d+)\\]"
      }
    },
    {
      "name": "StickDeadzone default: code matches ini",
      "a": {
        "file": "tcnyc_sdl3pad.c",
        "regex": "\"StickDeadzone\", (\\d+)"
      },
      "b": {
        "file": "TCNYCSDL3Pad.ini",
        "regex": "\\nStickDeadzone=(\\d+)"
      }
    },
    {
      "name": "StickDeadzone default: ini matches README",
      "a": {
        "file": "TCNYCSDL3Pad.ini",
        "regex": "\\nStickDeadzone=(\\d+)"
      },
      "b": {
        "file": "README.md",
        "regex": "\\| `StickDeadzone` \\| (\\d+) \\|"
      }
    },
    {
      "name": "TriggerThreshold default: code matches ini",
      "a": {
        "file": "tcnyc_sdl3pad.c",
        "regex": "\"TriggerThreshold\", (\\d+)"
